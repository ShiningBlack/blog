---
import { Moon, Sun } from 'lucide-astro';
---

<button
  type="button"
  id="theme-toggle"
  aria-label="切换亮暗主题"
  title="切换亮暗主题"
  class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-[var(--border)] bg-[var(--bg-card)] text-[var(--text-muted)] transition hover:border-[var(--accent)] hover:text-[var(--text)] cursor-pointer"
>
  <Sun class="h-4 w-4 hidden dark:block" />
  <Moon class="h-4 w-4 block dark:hidden" />
</button>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      const root = document.documentElement;
      const isDark = root.classList.toggle('dark');
      const nextTheme = isDark ? 'dark' : 'light';
      try {
        localStorage.setItem('theme', nextTheme);
      } catch (_) {}
      window.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: nextTheme } }));
    });
  })();
</script>
