---
import { formatDate, getReadingStats, type BlogPost } from '../utils/blog';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { title, description, pubDate, category, pinned, draft } = post.data;
const stats = getReadingStats(post.body);
---

<article class="group py-7 first:pt-2">
  <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm text-[var(--text-subtle)]">
    <time datetime={pubDate.toISOString()} class="font-mono tabular-nums">
      {formatDate(pubDate)}
    </time>
    <span>·</span>
    <span class="font-medium text-[var(--accent-warm)]">{category}</span>
    <span>·</span>
    <span>{stats.minutes} 分钟阅读</span>
    {pinned && <span class="font-medium text-[var(--accent)]">· 置顶</span>}
    {draft && <span class="font-medium text-[var(--accent-warm)]">· 草稿</span>}
  </div>

  <h2 class="mt-2 text-xl sm:text-[1.45rem] font-extrabold tracking-tight text-[var(--text)] leading-snug">
    <a
      href={`/blog/${post.id}/`}
      class="group-hover:text-[var(--accent)] group-hover:underline underline-offset-4 decoration-2 transition-colors"
    >
      {title}
    </a>
  </h2>

  {
    description && (
      <p class="font-editorial mt-2.5 text-[1.05rem] sm:text-[1.1rem] leading-relaxed text-[var(--text-muted)] line-clamp-2">
        {description}
      </p>
    )
  }
</article>
