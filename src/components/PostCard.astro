---
import { formatDate, type BlogPost } from '../utils/blog';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { title, description, pubDate, pinned, draft } = post.data;
---

<article class="group py-4 first:pt-0">
  <a href={`/blog/${post.id}/`} class="block">
    <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
      <h2 class="text-base font-medium text-[var(--text)] group-hover:underline underline-offset-4 decoration-[var(--text-subtle)]">
        {pinned && <span class="mr-1.5 text-xs text-[var(--text-subtle)]">[置顶]</span>}
        {draft && <span class="mr-1.5 text-xs text-[var(--text-subtle)]">[草稿]</span>}
        {title}
      </h2>
      <time
        datetime={pubDate.toISOString()}
        class="shrink-0 font-mono text-xs text-[var(--text-subtle)] tabular-nums"
      >
        {formatDate(pubDate)}
      </time>
    </div>
    {
      description && (
        <p class="mt-1.5 text-sm leading-relaxed text-[var(--text-muted)] line-clamp-2">
          {description}
        </p>
      )
    }
  </a>
</article>
