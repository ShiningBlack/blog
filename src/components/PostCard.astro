---
import { Pin } from 'lucide-astro';
import { formatDate, getReadingStats, type BlogPost } from '../utils/blog';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { title, description, pubDate, category, tags = [], pinned, draft } = post.data;
const stats = getReadingStats(post.body);
---

<article
  class="group rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] p-5 sm:p-6 transition hover:border-[var(--accent)]"
>
  <div class="flex flex-wrap items-center gap-2 text-xs text-[var(--text-subtle)]">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    <span>·</span>
    <span>{category}</span>
    <span>·</span>
    <span>约 {stats.minutes} 分钟阅读</span>
    {
      pinned && (
        <span class="inline-flex items-center gap-1 rounded-full bg-[var(--accent-soft)] px-2 py-0.5 font-medium text-[var(--accent)]">
          <Pin class="h-3 w-3" /> 置顶
        </span>
      )
    }
    {
      draft && (
        <span class="rounded-full bg-amber-500/15 px-2 py-0.5 font-medium text-amber-600 dark:text-amber-400">
          草稿
        </span>
      )
    }
  </div>

  <h2 class="mt-2.5 text-lg sm:text-xl font-bold tracking-tight text-[var(--text)] group-hover:text-[var(--accent)] transition-colors">
    <a href={`/blog/${post.id}/`} class="block">
      {title}
    </a>
  </h2>

  <p class="mt-2 text-sm leading-relaxed text-[var(--text-muted)] line-clamp-2">
    {description}
  </p>

  {
    tags.length > 0 && (
      <div class="mt-3.5 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <a
            href={`/tags/${encodeURIComponent(tag)}/`}
            class="rounded-md border border-[var(--border)] bg-[var(--bg-muted)] px-2 py-0.5 text-xs text-[var(--text-muted)] transition hover:border-[var(--accent)] hover:text-[var(--accent)]"
          >
            # {tag}
          </a>
        ))}
      </div>
    )
  }
</article>
