---
import { Rss } from 'lucide-astro';
import { SITE } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-[var(--border)] bg-[var(--bg-muted)]/40">
  <div
    class="mx-auto flex max-w-4xl flex-col sm:flex-row items-center justify-between gap-4 px-4 py-8 text-xs text-[var(--text-muted)] sm:px-6"
  >
    <p>
      © {year} {SITE.author}. Built with Astro &amp; hosted on Vercel.
    </p>
    <div class="flex items-center gap-4">
      <a
        href={SITE.github}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-[var(--text)] transition-colors"
      >
        GitHub
      </a>
      <a href="/rss.xml" class="inline-flex items-center gap-1 hover:text-[var(--text)] transition-colors">
        <Rss class="h-3.5 w-3.5" /> RSS
      </a>
      <a href="/admin/" class="hover:text-[var(--text)] transition-colors">
        后台管理
      </a>
    </div>
  </div>
</footer>
