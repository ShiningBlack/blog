---
import { SITE } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="mx-auto mt-auto w-full max-w-2xl px-5 pb-10 pt-6 sm:px-6">
  <div
    class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-t border-[var(--border)] pt-6 text-xs text-[var(--text-subtle)]"
  >
    <p>© {year} {SITE.author}</p>
    <div class="flex items-center gap-4">
      <a
        href={SITE.github}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-[var(--text)] transition-colors"
      >
        GitHub
      </a>
      <a href="/rss.xml" class="hover:text-[var(--text)] transition-colors">
        RSS
      </a>
      <a href="/admin/" class="hover:text-[var(--text)] transition-colors">
        写文章
      </a>
    </div>
  </div>
</footer>
