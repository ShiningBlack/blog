---
import { Menu, Search, X } from 'lucide-astro';
import { SITE } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
---

<header
  class="sticky top-0 z-40 border-b border-[var(--border)] bg-[var(--bg)]/85 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-4xl items-center justify-between px-4 sm:px-6">
    <a
      href="/"
      class="flex items-center gap-2.5 font-bold tracking-tight text-[var(--text)] hover:text-[var(--accent)] transition-colors"
    >
      <img src="/favicon.svg" alt="" class="h-6 w-6 rounded-md" />
      <span>{SITE.title}</span>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm">
      {
        SITE.nav.map((item) => {
          const isActive =
            item.href === '/' ? pathname === '/' : pathname.startsWith(item.href);
          return (
            <a
              href={item.href}
              class={`transition-colors ${
                isActive
                  ? 'font-semibold text-[var(--accent)]'
                  : 'text-[var(--text-muted)] hover:text-[var(--text)]'
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="search-trigger"
        aria-label="站内搜索"
        title="站内搜索 (Ctrl/Cmd + K)"
        class="inline-flex h-9 items-center gap-2 rounded-lg border border-[var(--border)] bg-[var(--bg-card)] px-2.5 text-xs text-[var(--text-muted)] transition hover:border-[var(--accent)] hover:text-[var(--text)] cursor-pointer"
      >
        <Search class="h-3.5 w-3.5" />
        <span class="hidden sm:inline">搜索</span>
        <kbd class="hidden sm:inline rounded bg-[var(--bg-muted)] px-1.5 py-0.5 font-mono text-[10px] text-[var(--text-subtle)]">
          ⌘K
        </kbd>
      </button>

      <ThemeToggle />

      <button
        type="button"
        id="mobile-menu-toggle"
        aria-label="展开导航菜单"
        class="inline-flex md:hidden h-9 w-9 items-center justify-center rounded-lg border border-[var(--border)] bg-[var(--bg-card)] text-[var(--text-muted)] cursor-pointer"
      >
        <Menu id="mobile-menu-open-icon" class="h-4 w-4" />
        <X id="mobile-menu-close-icon" class="h-4 w-4 hidden" />
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="hidden md:hidden border-t border-[var(--border)] bg-[var(--bg)] px-4 py-3 space-y-1 text-sm"
  >
    {
      SITE.nav.map((item) => {
        const isActive = item.href === '/' ? pathname === '/' : pathname.startsWith(item.href);
        return (
          <a
            href={item.href}
            class={`block rounded-lg px-3 py-2 ${
              isActive
                ? 'bg-[var(--accent-soft)] font-semibold text-[var(--accent)]'
                : 'text-[var(--text-muted)] hover:bg-[var(--bg-muted)]'
            }`}
          >
            {item.label}
          </a>
        );
      })
    }
  </nav>
</header>

<script is:inline>
  (function () {
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const openIcon = document.getElementById('mobile-menu-open-icon');
    const closeIcon = document.getElementById('mobile-menu-close-icon');
    if (!toggle || !menu) return;

    toggle.addEventListener('click', function () {
      const hidden = menu.classList.toggle('hidden');
      if (openIcon && closeIcon) {
        openIcon.classList.toggle('hidden', !hidden);
        closeIcon.classList.toggle('hidden', hidden);
      }
    });
  })();
</script>
