---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={`项目 | ${SITE.title}`} description="个人开源项目与作品展示">
  <header class="mb-10">
    <h1 class="text-xl font-semibold tracking-tight text-[var(--text)]">项目</h1>
    <p class="mt-1.5 text-sm text-[var(--text-subtle)]">一些个人维护的工具与开源作品</p>
  </header>

  <ul class="divide-y divide-[var(--border)]">
    {
      projects.map((project) => (
        <li class="py-5 first:pt-0">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-base font-medium text-[var(--text)]">{project.data.title}</h2>
            <div class="flex items-center gap-3 shrink-0 text-xs text-[var(--text-subtle)]">
              {project.data.url && (
                <a
                  href={project.data.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-[var(--text)] transition-colors"
                >
                  访问 ↗
                </a>
              )}
              {project.data.repo && (
                <a
                  href={project.data.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-[var(--text)] transition-colors"
                >
                  GitHub ↗
                </a>
              )}
            </div>
          </div>

          <p class="mt-1.5 text-sm leading-relaxed text-[var(--text-muted)]">
            {project.data.description}
          </p>

          {project.data.tech.length > 0 && (
            <p class="mt-2 font-mono text-xs text-[var(--text-subtle)]">
              {project.data.tech.join(' · ')}
            </p>
          )}
        </li>
      ))
    }
  </ul>
</BaseLayout>
