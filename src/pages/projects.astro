---
import { getCollection } from 'astro:content';
import { ExternalLink, Github } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={`项目 | ${SITE.title}`} description="个人开源项目与作品展示">
  <header class="mb-8 border-b border-[var(--border)] pb-6">
    <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[var(--text)]">项目作品</h1>
    <p class="mt-2 text-sm text-[var(--text-muted)]">
      一些个人维护的工具、实验项目与开源作品，可在 <a href="/admin/" class="text-[var(--accent)] underline">/admin</a> 后台直接增删管理。
    </p>
  </header>

  <div class="grid gap-4 sm:grid-cols-2">
    {
      projects.map((project) => (
        <div class="flex flex-col justify-between rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] p-5 transition hover:border-[var(--accent)]">
          <div>
            <div class="flex items-start justify-between gap-3">
              <h2 class="text-base font-bold text-[var(--text)]">{project.data.title}</h2>
              <div class="flex items-center gap-2.5 text-[var(--text-muted)]">
                {project.data.repo && (
                  <a
                    href={project.data.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${project.data.title} GitHub`}
                    class="hover:text-[var(--accent)]"
                  >
                    <Github class="h-4 w-4" />
                  </a>
                )}
                {project.data.url && (
                  <a
                    href={project.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${project.data.title} 在线地址`}
                    class="hover:text-[var(--accent)]"
                  >
                    <ExternalLink class="h-4 w-4" />
                  </a>
                )}
              </div>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">
              {project.data.description}
            </p>
          </div>
          {project.data.tech.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-1.5">
              {project.data.tech.map((t) => (
                <span class="rounded-md bg-[var(--bg-muted)] px-2 py-0.5 text-xs text-[var(--text-muted)]">
                  {t}
                </span>
              ))}
            </div>
          )}
        </div>
      ))
    }
  </div>
</BaseLayout>
