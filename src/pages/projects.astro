---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={`项目 | ${SITE.title}`} description="个人开源项目与作品展示">
  <header class="mb-10 pb-6 border-b border-[var(--border)]">
    <h1 class="text-3xl font-extrabold tracking-tight text-[var(--text)]">项目</h1>
    <p class="font-editorial mt-2 text-lg text-[var(--text-muted)]">一些个人维护的工具与开源作品</p>
  </header>

  <ul class="divide-y divide-[var(--border)]">
    {
      projects.map((project) => (
        <li class="py-7 first:pt-2">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-xl font-extrabold tracking-tight text-[var(--text)]">
              {project.data.title}
            </h2>
            <div class="flex items-center gap-4 shrink-0 text-sm font-medium">
              {project.data.url && (
                <a
                  href={project.data.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[var(--accent)] underline underline-offset-4 decoration-2 hover:text-[var(--accent-warm)]"
                >
                  访问 ↗
                </a>
              )}
              {project.data.repo && (
                <a
                  href={project.data.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[var(--accent-warm)] underline underline-offset-4 decoration-2 hover:text-[var(--accent)]"
                >
                  GitHub ↗
                </a>
              )}
            </div>
          </div>

          <p class="font-editorial mt-2.5 text-[1.08rem] leading-relaxed text-[var(--text-muted)]">
            {project.data.description}
          </p>

          {project.data.tech.length > 0 && (
            <p class="mt-3 font-mono text-xs text-[var(--text-subtle)]">
              {project.data.tech.join(' · ')}
            </p>
          )}
        </li>
      ))
    }
  </ul>
</BaseLayout>
