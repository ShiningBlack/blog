---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';
import { collectTags, isPublished } from '../../utils/blog';

const posts = await getCollection('blog', isPublished);
const tags = collectTags(posts);
---

<BaseLayout title={`标签 | ${SITE.title}`} description="按标签浏览所有文章">
  <header class="mb-10">
    <h1 class="text-xl font-semibold tracking-tight text-[var(--text)]">标签</h1>
    <p class="mt-1.5 text-sm text-[var(--text-subtle)]">共 {tags.length} 个标签</p>
  </header>

  <div class="flex flex-wrap gap-x-5 gap-y-3 text-sm">
    {
      tags.map(({ tag, count }) => (
        <a
          href={`/tags/${encodeURIComponent(tag)}/`}
          class="text-[var(--text-muted)] hover:text-[var(--text)] hover:underline underline-offset-4 decoration-[var(--text-subtle)] transition-colors"
        >
          #{tag}
          <span class="ml-1 font-mono text-xs text-[var(--text-subtle)]">{count}</span>
        </a>
      ))
    }
  </div>
</BaseLayout>
