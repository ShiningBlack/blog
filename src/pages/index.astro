---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../config/site';
import { isPublished, sortPosts } from '../utils/blog';

const allPosts = sortPosts(await getCollection('blog', isPublished));
const recentPosts = allPosts.slice(0, 10);

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 5);
---

<BaseLayout>
  <section class="pb-12 border-b border-[var(--border)]">
    <h1 class="text-3xl sm:text-[2.25rem] font-extrabold tracking-tight text-[var(--text)] leading-tight">
      {SITE.title}
    </h1>
    <p class="font-editorial mt-4 text-lg sm:text-[1.2rem] leading-relaxed text-[var(--text-muted)]">
      {SITE.description}
    </p>
  </section>

  <section class="mt-12">
    <div class="mb-4 flex items-baseline justify-between">
      <h2 class="text-sm font-bold tracking-wide text-[var(--text-subtle)] uppercase">最新文章</h2>
      {
        allPosts.length > recentPosts.length && (
          <a
            href="/archives"
            class="text-sm font-medium text-[var(--accent)] underline underline-offset-4 decoration-2 hover:text-[var(--accent-warm)] transition-colors"
          >
            全部 {allPosts.length} 篇 →
          </a>
        )
      }
    </div>

    {
      recentPosts.length > 0 ? (
        <div class="divide-y divide-[var(--border)]">
          {recentPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="font-editorial py-4 text-lg text-[var(--text-muted)]">
          暂无已发布文章，前往
          <a
            href="/admin/"
            class="mx-1 font-semibold text-[var(--accent)] underline underline-offset-4 decoration-2"
          >
            写作后台
          </a>
          发布第一篇吧。
        </p>
      )
    }
  </section>

  {
    projects.length > 0 && (
      <section class="mt-14 pt-12 border-t border-[var(--border)]">
        <div class="mb-6 flex items-baseline justify-between">
          <h2 class="text-sm font-bold tracking-wide text-[var(--text-subtle)] uppercase">
            精选项目
          </h2>
          <a
            href="/projects"
            class="text-sm font-medium text-[var(--accent)] underline underline-offset-4 decoration-2 hover:text-[var(--accent-warm)] transition-colors"
          >
            全部项目 →
          </a>
        </div>

        <ul class="space-y-6">
          {projects.map((project) => (
            <li>
              <div class="flex items-baseline justify-between gap-4">
                <a
                  href={project.data.url || project.data.repo || '/projects'}
                  target={project.data.url || project.data.repo ? '_blank' : undefined}
                  rel={project.data.url || project.data.repo ? 'noopener noreferrer' : undefined}
                  class="text-lg font-bold text-[var(--text)] hover:text-[var(--accent)] hover:underline underline-offset-4 decoration-2 transition-colors"
                >
                  {project.data.title}
                </a>
                {project.data.repo && (
                  <a
                    href={project.data.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="shrink-0 text-sm font-medium text-[var(--accent-warm)] hover:underline underline-offset-4"
                  >
                    GitHub ↗
                  </a>
                )}
              </div>
              <p class="font-editorial mt-1.5 text-[1.05rem] leading-relaxed text-[var(--text-muted)]">
                {project.data.description}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
