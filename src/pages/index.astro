---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../config/site';
import { isPublished, sortPosts } from '../utils/blog';

const allPosts = sortPosts(await getCollection('blog', isPublished));
const recentPosts = allPosts.slice(0, 10);

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 5);
---

<BaseLayout>
  <section class="pb-10">
    <p class="text-sm leading-relaxed text-[var(--text-muted)]">
      {SITE.description}
    </p>
  </section>

  <section>
    <div class="mb-4 flex items-baseline justify-between">
      <h1 class="text-xs font-medium tracking-wider text-[var(--text-subtle)] uppercase">文章</h1>
      {
        allPosts.length > recentPosts.length && (
          <a
            href="/archives"
            class="text-xs text-[var(--text-subtle)] hover:text-[var(--text)] transition-colors"
          >
            全部 {allPosts.length} 篇 →
          </a>
        )
      }
    </div>

    {
      recentPosts.length > 0 ? (
        <div class="divide-y divide-[var(--border)]">
          {recentPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="text-sm text-[var(--text-muted)]">
          暂无文章，前往 <a href="/admin/" class="underline underline-offset-4">后台</a> 发布第一篇。
        </p>
      )
    }
  </section>

  {
    projects.length > 0 && (
      <section class="mt-14 pt-10 border-t border-[var(--border)]">
        <div class="mb-4 flex items-baseline justify-between">
          <h2 class="text-xs font-medium tracking-wider text-[var(--text-subtle)] uppercase">项目</h2>
          <a
            href="/projects"
            class="text-xs text-[var(--text-subtle)] hover:text-[var(--text)] transition-colors"
          >
            全部 →
          </a>
        </div>

        <ul class="space-y-4">
          {projects.map((project) => (
            <li>
              <div class="flex items-baseline justify-between gap-4">
                <a
                  href={project.data.url || project.data.repo || '/projects'}
                  target={project.data.url || project.data.repo ? '_blank' : undefined}
                  rel={project.data.url || project.data.repo ? 'noopener noreferrer' : undefined}
                  class="text-sm font-medium text-[var(--text)] hover:underline underline-offset-4 decoration-[var(--text-subtle)]"
                >
                  {project.data.title}
                </a>
                {project.data.repo && (
                  <a
                    href={project.data.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="shrink-0 text-xs text-[var(--text-subtle)] hover:text-[var(--text)] transition-colors"
                  >
                    GitHub ↗
                  </a>
                )}
              </div>
              <p class="mt-1 text-sm text-[var(--text-muted)]">{project.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
