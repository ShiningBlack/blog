---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TOC from '../../components/TOC.astro';
import Comments from '../../components/Comments.astro';
import { SITE } from '../../config/site';
import { formatDate, getReadingStats, isPublished, sortPosts } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('blog', isPublished));
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: index < posts.length - 1 ? posts[index + 1] : null,
      nextPost: index > 0 ? posts[index - 1] : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const stats = getReadingStats(post.body);
const { title, description, pubDate, updatedDate, category, tags = [], cover } = post.data;
---

<BaseLayout title={`${title} | ${SITE.title}`} description={description} image={cover} type="article">
  <article data-pagefind-body>
    <header class="mb-10 pb-8 border-b border-[var(--border)]">
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm text-[var(--text-subtle)]">
        <time datetime={pubDate.toISOString()} class="font-mono tabular-nums">
          {formatDate(pubDate)}
        </time>
        {updatedDate && <span class="font-mono">· 更新于 {formatDate(updatedDate)}</span>}
        <span>·</span>
        <span class="font-medium text-[var(--accent-warm)]">{category}</span>
        <span>·</span>
        <span>约 {stats.words} 字，{stats.minutes} 分钟</span>
      </div>

      <h1 class="mt-3 text-3xl sm:text-[2.25rem] font-extrabold tracking-tight text-[var(--text)] leading-tight">
        {title}
      </h1>

      {
        tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm">
            {tags.map((tag) => (
              <a
                href={`/tags/${encodeURIComponent(tag)}/`}
                class="font-medium text-[var(--accent)] hover:text-[var(--accent-warm)] hover:underline underline-offset-4 decoration-2 transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        )
      }

      {
        cover && (
          <img
            src={cover}
            alt={title}
            class="mt-8 max-h-[26rem] w-full rounded-xl bg-[var(--bg-muted)] object-cover"
          />
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <TOC headings={headings} />

  {
    (prevPost || nextPost) && (
      <nav
        aria-label="上下篇导航"
        class="mt-16 flex flex-col sm:flex-row justify-between gap-4 border-t border-[var(--border)] pt-8 text-base"
      >
        {prevPost ? (
          <a
            href={`/blog/${prevPost.id}/`}
            class="font-medium text-[var(--accent)] hover:text-[var(--accent-warm)] hover:underline underline-offset-4 decoration-2 transition-colors"
          >
            ← {prevPost.data.title}
          </a>
        ) : (
          <span />
        )}

        {nextPost && (
          <a
            href={`/blog/${nextPost.id}/`}
            class="text-right font-medium text-[var(--accent)] hover:text-[var(--accent-warm)] hover:underline underline-offset-4 decoration-2 transition-colors"
          >
            {nextPost.data.title} →
          </a>
        )}
      </nav>
    )
  }

  <Comments />
</BaseLayout>
