---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TOC from '../../components/TOC.astro';
import Comments from '../../components/Comments.astro';
import { SITE } from '../../config/site';
import { formatDate, getReadingStats, isPublished, sortPosts } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('blog', isPublished));
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: index < posts.length - 1 ? posts[index + 1] : null,
      nextPost: index > 0 ? posts[index - 1] : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const stats = getReadingStats(post.body);
const { title, description, pubDate, updatedDate, category, tags = [], cover } = post.data;
---

<BaseLayout title={`${title} | ${SITE.title}`} description={description} image={cover} type="article">
  <article data-pagefind-body>
    <header class="mb-10">
      <h1 class="text-2xl sm:text-[1.75rem] font-semibold tracking-tight text-[var(--text)] leading-snug">
        {title}
      </h1>

      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-[var(--text-subtle)]">
        <time datetime={pubDate.toISOString()} class="font-mono tabular-nums">
          {formatDate(pubDate)}
        </time>
        {updatedDate && <span class="font-mono">更新于 {formatDate(updatedDate)}</span>}
        <span>·</span>
        <span>{category}</span>
        <span>·</span>
        <span>约 {stats.words} 字，{stats.minutes} 分钟</span>
      </div>

      {
        tags.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs text-[var(--text-subtle)]">
            {tags.map((tag) => (
              <a
                href={`/tags/${encodeURIComponent(tag)}/`}
                class="hover:text-[var(--text)] transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        )
      }

      {
        cover && (
          <img
            src={cover}
            alt={title}
            class="mt-8 max-h-96 w-full rounded object-cover"
          />
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <TOC headings={headings} />

  {
    (prevPost || nextPost) && (
      <nav
        aria-label="上下篇导航"
        class="mt-14 flex flex-col sm:flex-row justify-between gap-4 border-t border-[var(--border)] pt-6 text-sm"
      >
        {prevPost ? (
          <a
            href={`/blog/${prevPost.id}/`}
            class="text-[var(--text-muted)] hover:text-[var(--text)] transition-colors"
          >
            ← {prevPost.data.title}
          </a>
        ) : (
          <span />
        )}

        {nextPost && (
          <a
            href={`/blog/${nextPost.id}/`}
            class="text-right text-[var(--text-muted)] hover:text-[var(--text)] transition-colors"
          >
            {nextPost.data.title} →
          </a>
        )}
      </nav>
    )
  }

  <Comments />
</BaseLayout>
