---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import { formatDate, groupPostsByYear, isPublished, sortPosts } from '../utils/blog';

const posts = sortPosts(await getCollection('blog', isPublished));
const grouped = groupPostsByYear(posts);
---

<BaseLayout title={`归档 | ${SITE.title}`} description="按年份浏览所有博客文章">
  <header class="mb-10">
    <h1 class="text-xl font-semibold tracking-tight text-[var(--text)]">归档</h1>
    <p class="mt-1.5 text-sm text-[var(--text-subtle)]">共 {posts.length} 篇文章</p>
  </header>

  {
    grouped.length > 0 ? (
      <div class="space-y-10">
        {grouped.map(({ year, posts: yearPosts }) => (
          <section>
            <h2 class="mb-3 font-mono text-xs font-medium text-[var(--text-subtle)]">{year}</h2>
            <ul class="space-y-3">
              {yearPosts.map((post) => (
                <li class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                  <a
                    href={`/blog/${post.id}/`}
                    class="text-[0.95rem] text-[var(--text)] hover:underline underline-offset-4 decoration-[var(--text-subtle)]"
                  >
                    {post.data.title}
                  </a>
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="shrink-0 font-mono text-xs text-[var(--text-subtle)] tabular-nums"
                  >
                    {formatDate(post.data.pubDate)}
                  </time>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    ) : (
      <p class="text-sm text-[var(--text-muted)]">暂无已发布文章。</p>
    )
  }
</BaseLayout>
