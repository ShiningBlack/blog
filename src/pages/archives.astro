---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import { formatDate, groupPostsByYear, isPublished, sortPosts } from '../utils/blog';

const posts = sortPosts(await getCollection('blog', isPublished));
const grouped = groupPostsByYear(posts);
---

<BaseLayout title={`文章归档 | ${SITE.title}`} description="按年份浏览所有博客文章">
  <header class="mb-8 border-b border-[var(--border)] pb-6">
    <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[var(--text)]">文章归档</h1>
    <p class="mt-2 text-sm text-[var(--text-muted)]">共 {posts.length} 篇文章，按发布年份整理。</p>
  </header>

  {
    grouped.length > 0 ? (
      <div class="space-y-10">
        {grouped.map(({ year, posts: yearPosts }) => (
          <section>
            <h2 class="mb-4 flex items-center gap-2 text-lg font-bold text-[var(--text)]">
              <span>{year}</span>
              <span class="rounded-full bg-[var(--bg-muted)] px-2.5 py-0.5 text-xs font-normal text-[var(--text-muted)]">
                {yearPosts.length} 篇
              </span>
            </h2>

            <ul class="space-y-2.5 border-l border-[var(--border)] pl-4">
              {yearPosts.map((post) => (
                <li class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 rounded-lg px-2 py-1.5 transition hover:bg-[var(--bg-muted)]">
                  <a
                    href={`/blog/${post.id}/`}
                    class="font-medium text-[var(--text)] hover:text-[var(--accent)] transition-colors"
                  >
                    {post.data.title}
                  </a>
                  <div class="flex items-center gap-3 text-xs text-[var(--text-subtle)] shrink-0">
                    <span>{post.data.category}</span>
                    <time datetime={post.data.pubDate.toISOString()}>
                      {formatDate(post.data.pubDate)}
                    </time>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    ) : (
      <p class="text-sm text-[var(--text-muted)]">暂无已发布文章。</p>
    )
  }
</BaseLayout>
